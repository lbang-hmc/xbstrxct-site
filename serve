#!/usr/bin/env bash
# Live preview of XBSTRXCT at http://localhost:8080 (Ctrl+C to stop).
# `./serve --drafts` also shows pages marked `draft: true` (never part of the published site).
# Other arguments are passed to `quartz build`, e.g. `./serve --port 8081`.
set -euo pipefail
cd "$(dirname "$0")"

# Node 22 via nvm (see .nvmrc); falls back to whatever `node` is on PATH.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use --silent || nvm install
fi
node_major=$(node -p 'process.versions.node.split(".")[0]')
if [ "$node_major" -lt 22 ]; then
  echo "Quartz needs Node >= 22, found $(node -v). Install nvm, then run: nvm install 22" >&2
  exit 1
fi

# First run (or after a fresh clone): install dependencies and pinned plugins.
[ -d node_modules ] || npm ci
[ -d .quartz/plugins ] || npx quartz plugin install

args=()
for a in "$@"; do
  if [ "$a" = "--drafts" ]; then export ABSTRACTION_DRAFTS=1; else args+=("$a"); fi
done
[ "${ABSTRACTION_DRAFTS:-}" = 1 ] && echo "Including draft pages (not part of the published site)."
exec npx quartz build --serve "${args[@]}"
