#!/usr/bin/env bash
# Live preview of abstraction.wiki at http://localhost:8080 (Ctrl+C to stop).
# Extra arguments are passed to `quartz build`, e.g. `./serve --port 8081`.
set -euo pipefail
cd "$(dirname "$0")"

# Node 22 via nvm (see .nvmrc); falls back to whatever `node` is on PATH.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use --silent || nvm install
fi
node_major=$(node -p 'process.versions.node.split(".")[0]')
if [ "$node_major" -lt 22 ]; then
  echo "Quartz needs Node >= 22, found $(node -v). Install nvm, then run: nvm install 22" >&2
  exit 1
fi

# First run (or after a fresh clone): install dependencies and pinned plugins.
[ -d node_modules ] || npm ci
[ -d .quartz/plugins ] || npx quartz plugin install

exec npx quartz build --serve "$@"
