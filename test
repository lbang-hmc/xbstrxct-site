#!/usr/bin/env bash
# Run abstraction.wiki checks: inline tags, links, dates, broken links, build warnings.
set -euo pipefail
cd "$(dirname "$0")"
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then . "$NVM_DIR/nvm.sh"; nvm use --silent || nvm install; fi
exec node tests/run-tests.mjs "$@"
